# copy to deploy/host.env (git-ignored) and fill in. install.sh reads it.

# Tailscale address of the server; the upload service binds here only
BIND_HOST=100.64.0.1
PORT=8787
# tailnet addresses allowed to upload, space-separated CIDRs
ALLOWED_CLIENTS="100.64.0.2/32"

PUBLIC_HOST=img.example.com
# certificate nginx presents for PUBLIC_HOST (a Cloudflare origin certificate works)
SSL_CERT=/etc/ssl/example/cert.pem
SSL_KEY=/etc/ssl/example/key.pem
